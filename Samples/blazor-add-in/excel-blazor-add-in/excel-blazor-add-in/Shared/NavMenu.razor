@implements IDisposable

<nav class="tab-bar" role="tablist">
	@foreach (var tab in AllTabs)
	{
		if (HiddenPaths?.Contains(tab.Path) == true) continue;
		var isActive = IsActive(tab.Path);
		<button type="button"
				role="tab"
				aria-selected="@isActive"
				class="tab @(isActive ? "tab-active" : null)"
				@onclick="@(() => MoveToPage(tab.Path))">
			@tab.Label
		</button>
	}
</nav>

@code {
	public record Tab(string Label, string Path);

	public static readonly Tab[] AllTabs = new[]
	{
		new Tab("Hello World", "/"),
		new Tab("Bubble Chart", "/bubblechart"),
		new Tab("Showcase", "/showcase"),
		new Tab("Tab A", "/tab-a"),
		new Tab("AI", "/ai"),
	};

	[Parameter]
	public string[]? HiddenPaths { get; set; }

	[Inject]
	public NavigationManager NavigationManager { get; set; } = default!;

	protected override void OnInitialized()
	{
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
	{
		StateHasChanged();
	}

	private bool IsActive(string path)
	{
		var relative = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
		if (path == "/") return relative == "/" || string.IsNullOrEmpty(relative);
		return string.Equals(relative, path, StringComparison.OrdinalIgnoreCase);
	}

	private void MoveToPage(string page)
	{
		NavigationManager.NavigateTo(page, true);
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= OnLocationChanged;
	}
}
